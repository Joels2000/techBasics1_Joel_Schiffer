import csv
import os
import time

DEBUG = True  # Added this flag for testing the leaderboard quickly!

inventory = []
MAX_INVENTORY = 5

items_in_room = [
    {"name": "Keycard", "type": "tool", "description": "A golden keycard used to unlock the cockpit."},
    {"name": "battery", "type": "tool", "description": "A fully charged battery for the life support system."},
    {"name": "apple", "type": "food", "description": "A fresh, red apple.", "uses": 1},
    {"name": "note", "type": "lore", "description": "Scrawled on it: 'Turn on the power, use the keycard, take off!'"},
    {"name": "cup", "type": "trash", "description": "An empty plastic cup."}
]

ship_powered = False
game_running = True
start_time = time.time()  # Track when the game started


def save_and_show_leaderboard(final_time):
    """Saves the player's time and shows the top scores."""
    print("\n=== GAME OVER ===")
    player_name = input("Enter your name for the leaderboard: ")
    
    current_timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    
    final_time = round(final_time, 1)
    
    new_record = [player_name, current_timestamp, str(final_time)]
    all_records = []
    
    # I kept getting a FileNotFoundError when the game ran for the first time.
    # I fixed it by using try/except. 
    try:
        with open("leaderboard.csv", mode="r", newline="") as file:
            reader = csv.reader(file)
            all_records = list(reader)
    except FileNotFoundError:
        # No file found means this is the first game ever played
        print("No existing records found. Creating a new leaderboard file!")
    except Exception as e:
        # Just in case something else breaks (like a corrupted file)
        print("Something went wrong reading the file:", e)

    all_records.append(new_record)
    
    # I had a massive headache trying to sort the times because they were strings.
    # I overcame this by using float(x[2]) inside the lambda so python sorts by actual numbers.
  
    try:
        all_records.sort(key=lambda x: float(x[2]))
    except Exception:
        # Fallback just in case sorting crashes on bad data
        pass

    try:
        with open("leaderboard.csv", mode="w", newline="") as file:
            writer = csv.writer(file)
            writer.writerows(all_records)
    except Exception as e:
        print("Could not save your record to the file:", e)

    print("\n=== LEADERBOARD (Fastest Escapes) ===")
    print(f"{'Name':<15} | {'Date & Time':<20} | {'Time (Seconds)':<15}")
    print("-" * 55)
    
    for record in all_records[:5]:
        print(f"{record[0]:<15} | {record[1]:<20} | {record[2]:<15}")
print()


def show_room_items():
    if len(items_in_room) == 0: 
        print("The room is empty. There is nothing here.")
    else:
        print("In this room, you see the following items:")
        for item in items_in_room:
            print("- " + item['name']) 

def show_inventory():
    if len(inventory) == 0:
        print("Your inventory is completely empty.")
    else:
        print("Your Inventory:")
        for item in inventory:
            if item["type"] == "food":
                print("- " + item["name"] + " (Uses left: " + str(item["uses"]) + ")")
            else:
                print("- " + item["name"])

def pick_up():
    if len(inventory) >= MAX_INVENTORY:
        print("Your inventory is full! You need to drop something first.")
        return

    item_name = input("What do you want to pick up? ") 
    
    found_item = None
    for item in items_in_room:
        if item["name"] == item_name:
            found_item = item
            break

    if found_item != None:
        items_in_room.remove(found_item)
        inventory.append(found_item)
        print("You picked up the item.")
    else:
        print("There is no such item here.")

def drop():
    item_name = input("What do you want to drop? ")
    
    found_item = None
    for item in inventory:
        if item["name"] == item_name:
            found_item = item
            break

    if found_item != None:
        inventory.remove(found_item)
        items_in_room.append(found_item)
        print("You dropped it.")
    else:
        print("You don't have that in your inventory.")

def examine():
    item_name = input("What do you want to examine? ")
    found_item = None
    
    for item in inventory:
        if item["name"] == item_name:
            found_item = item
    for item in items_in_room:
        if item["name"] == item_name:
            found_item = item

    if found_item != None:
        print(found_item['description'])
    else:
        print("You don't see any item like that.")

def use():
    global ship_powered, game_running
    item_name = input("What do you want to use? ")
    
    found_item = None
    for item in inventory:
        if item["name"] == item_name:
            found_item = item

    if found_item == None:
        print("You don't have that item.")
        return

    if found_item["name"] == "battery":
        ship_powered = True
        inventory.remove(found_item)
        print("You insert the battery. The spaceship's lights flicker to life!")
        
    if found_item["name"] == "Keycard":
        if ship_powered == True:
            print("You swipe the keycard. You escaped! YOU WIN!")
            game_running = False
            # Calculate final score time and trigger leaderboard
            end_time = time.time()
            total_time = end_time - start_time
            save_and_show_leaderboard(total_time)
            
        if ship_powered == False: 
            print("Nothing happens without power. Find an energy source first.")
            
    if found_item["name"] == "apple":
        found_item["uses"] = found_item["uses"] - 1
        print("You eat the apple. Tasty!")
        if found_item["uses"] == 0:
            inventory.remove(found_item)

# I added this big if/else block here for the DEBUG flag requirement.
# If DEBUG is True, it completely jumps over the while loop and uses a fake score.
if DEBUG == True:
    print("--- DEBUG MODE ACTIVE ---")
    print("Skipping main game. Testing leaderboard saving with placeholder time.")
    placeholder_time = 42.5  # Testing score
    save_and_show_leaderboard(placeholder_time)

else:
    print("=== SPACESHIP ESCAPE ===")
    print("Type 'help' for a list of all commands.\n")

    while game_running == True:
        print("----------------------------------------")
        user_input = input("Enter command: ")
        
        if user_input == "help":
            print("Commands: look, inventory, pickup, drop, examine, use, quit")
        if user_input == "look":
            show_room_items()
        if user_input == "inventory":
            show_inventory()
        if user_input == "pickup":
            pick_up()
        if user_input == "drop":
            drop()
        if user_input == "examine":
            examine()
        if user_input == "use":
            use()
        if user_input == "quit":
            game_running = False
